rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(businessId) {
      return signedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if isOwner(businessId);

      // Public business profile: only expose fields that are safe for a booking page.
      // In production, consider splitting public business data into a separate document.
      allow get: if true;

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isOwner(businessId);
      }

      match /staff/{staffId} {
        allow read: if true;
        allow create, update, delete: if isOwner(businessId);
      }

      match /availability/{dayId} {
        allow read: if true;
        allow create, update, delete: if isOwner(businessId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(businessId);
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(businessId);
        allow create: if true;
        allow update, delete: if isOwner(businessId);
      }
    }
  }
}